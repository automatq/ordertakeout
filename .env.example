# Copy to .env.local and fill in. Never commit a real .env file.

# --- Database ---------------------------------------------------------------
# Neon, Supabase or Vercel Postgres. Use the POOLED connection string on Vercel.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# --- Store ------------------------------------------------------------------
# REQUIRED, no default. Every cutoff and pickup-slot calculation runs in this
# fallback zone. Each active Square location's timezone controls its own pickup
# schedule; this value covers legacy records and Square data without a timezone.
# Confirm it with the store before launch. IANA name, e.g. America/Toronto.
STORE_TIMEZONE=""

# REQUIRED, no default. The currency the Square locations actually bill in.
# A mismatch doesn't error; Square rejects any
# catalog variation priced in a different currency, so this app silently
# filters it out and the whole menu quietly goes empty. 3-letter ISO 4217 code.
STORE_CURRENCY=""

# --- Square -----------------------------------------------------------------
# From the Square Developer Console (https://developer.squareup.com/apps).
# Use Sandbox credentials for all development; swap to Production only at launch.
SQUARE_ACCESS_TOKEN=""
SQUARE_WEBHOOK_SIGNATURE_KEY=""
# Must match the webhook subscription URL in the Square console EXACTLY —
# it is part of the signed payload, so a trailing-slash mismatch fails verification.
SQUARE_WEBHOOK_NOTIFICATION_URL="https://example.com/api/webhooks/square"
# Only needed while backfilling orders created before multi-location support.
LEGACY_SQUARE_LOCATION_ID=""

# Safe to expose — the browser needs these to render the Square card form.
NEXT_PUBLIC_SQUARE_APPLICATION_ID=""
NEXT_PUBLIC_SQUARE_ENVIRONMENT="sandbox"

# --- Staff dashboard --------------------------------------------------------
# Shared password for the kitchen order screen. Minimum 8 characters.
STAFF_DASHBOARD_PASSWORD=""
# Stable random value; changing it invalidates existing customer tracking links.
ORDER_ACCESS_SECRET=""
# Separate secret for optional customer-account session cookies (32+ characters).
CUSTOMER_ACCOUNT_SECRET=""

# --- Notifications ----------------------------------------------------------
# All optional. An unset channel is skipped by the dispatcher, so the store can
# switch one on later without a code change.

RESEND_API_KEY=""
# A sender on a domain verified in Resend, e.g. Harina Orders <orders@harina.ca>.
NOTIFY_FROM_EMAIL=""
STORE_NOTIFY_EMAIL=""
# JSON map for branch-specific staff alerts, e.g. {"SQUARE_ID":"branch@example.com"}.
LOCATION_NOTIFY_EMAILS=""

TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
STORE_NOTIFY_PHONE=""
LOCATION_NOTIFY_PHONES=""

DISCORD_WEBHOOK_URL=""
SLACK_WEBHOOK_URL=""

TRELLO_KEY=""
TRELLO_TOKEN=""
TRELLO_LIST_ID=""

# Generic outbound webhook — receives a JSON POST for every order event.
CUSTOM_WEBHOOK_URL=""

# --- Operations -------------------------------------------------------------
CRON_SECRET=""
STORE_PUBLIC_URL="https://example.com"
# Set after agreeing a retention policy with the business (for example, 730).
CUSTOMER_DATA_RETENTION_DAYS=""

# --- Error monitoring (Sentry, optional) ------------------------------------
# Errors-only; tracing is off. Unset = monitoring disabled, nothing is sent.
# SENTRY_DSN covers the server (payments, webhooks, cron); the NEXT_PUBLIC one
# enables browser reporting and is inlined at build time, so a change needs a
# redeploy. Both usually share one Sentry project.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# Customer texts ("your order is ready") reuse the TWILIO_* credentials above and
# fire only for orders where the customer ticked the SMS box at checkout.
# Canadian delivery note: a toll-free From number needs Twilio's toll-free
# verification completed before carriers deliver reliably.
