{
  "expo": {
    "name": "Harina Bakeshoppe",
    "slug": "harina",
    "version": "0.1.0",
    "orientation": "portrait",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.harinabakeshoppe.app",
      "supportsTablet": false,
      "userInterfaceStyle": "automatic"
    },
    "android": {
      "package": "com.harinabakeshoppe.app",
      "userInterfaceStyle": "automatic",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ce3f23"
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f5f1e9",
          "dark": {
            "backgroundColor": "#15110d"
          },
          "image": "./assets/badge.png",
          "imageWidth": 120
        }
      ],
      "expo-image"
    ],
    "scheme": "harina",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png"
  }
}
